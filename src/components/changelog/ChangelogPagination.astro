---
/**
 * Prev/next + numbered page strip with ellipsis gaps
 * (first, last, current ±1 — Cloudflare style).
 */
import type { Page } from 'astro';
import { Icon } from '@astrojs/starlight/components';
import type { ChangelogEntry } from '../../data/changelog';

interface Props {
  page: Page<ChangelogEntry>;
  baseUrl: string;
}

const { page, baseUrl } = Astro.props;

function pageUrl(n: number): string {
  return n === 1 ? baseUrl : `${baseUrl}${n}/`;
}

const numbers: Array<number | null> = [];
for (let n = 1; n <= page.lastPage; n++) {
  if (n === 1 || n === page.lastPage || Math.abs(n - page.currentPage) <= 1) {
    numbers.push(n);
  } else if (numbers[numbers.length - 1] !== null) {
    numbers.push(null);
  }
}
---

{
  page.lastPage > 1 && (
    <nav class="changelog-pagination" aria-label="Changelog pages">
      <a class:list={['page-btn', { disabled: !page.url.prev }]} href={page.url.prev} aria-label="Previous page">
        <Icon name="left-arrow" />
      </a>
      <span class="page-numbers">
        {numbers.map((n) =>
          n === null ? (
            <span class="ellipsis">…</span>
          ) : (
            <a
              class:list={['page-btn', { active: n === page.currentPage }]}
              href={pageUrl(n)}
              aria-current={n === page.currentPage ? 'page' : undefined}
            >
              {n}
            </a>
          ),
        )}
      </span>
      <a class:list={['page-btn', { disabled: !page.url.next }]} href={page.url.next} aria-label="Next page">
        <Icon name="right-arrow" />
      </a>
    </nav>
  )
}

<style>
  .changelog-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem 0;
  }
  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .page-btn:hover:not(.disabled):not(.active) {
    background-color: var(--sl-color-gray-6);
  }
  .page-btn.active {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-white);
    pointer-events: none;
  }
  .page-btn.disabled {
    opacity: 0.35;
    pointer-events: none;
  }
  .ellipsis {
    color: var(--sl-color-gray-4);
    padding: 0 0.25rem;
    user-select: none;
  }
</style>
